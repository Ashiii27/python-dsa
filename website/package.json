{
  "name": "python-dsa-masterclass-site",
  "private": true,
  "scripts": {
    "gen": "python3 scripts/generate_content.py",
    "docusaurus": "docusaurus",
    "start": "npm run gen && docusaurus start --host 0.0.0.0",
    "build": "npm run gen && docusaurus build",
    "serve": "docusaurus serve --host 0.0.0.0",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/theme-mermaid": "^3.7.0",
    "@easyops-cn/docusaurus-search-local": "^0.46.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0"
  }
}
